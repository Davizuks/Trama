#!/usr/bin/env bash
# Sobe o servidor da Trama, se ainda não estiver no ar, e abre a interface no navegador.

# Lançadores do ambiente gráfico não carregam o nvm; sem isso o `node` não é encontrado.
if ! command -v node >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh" >/dev/null
fi

set -euo pipefail

repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
port="${TRAMA_PORT:-4747}"
url="http://127.0.0.1:$port"
running() { curl --silent --fail --max-time 1 "$url/api/token" >/dev/null 2>&1; }

if ! running; then
  cd "$repo"
  [ -d node_modules ] || npm install
  [ -f dist/index.html ] || npm run build
  log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/trama"
  mkdir -p "$log_dir"
  setsid nohup node src/server/main.ts >"$log_dir/server.log" 2>&1 &
  for _ in $(seq 1 50); do
    running && break
    sleep 0.1
  done
  running || { echo "A Trama não subiu. Veja $log_dir/server.log" >&2; exit 1; }
fi

xdg-open "$url/" >/dev/null 2>&1 || echo "Abra $url no navegador."
