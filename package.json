{
  "name": "trama",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Uma teia viva dos seus chats do Claude Code, ligados a um cérebro de notas Markdown.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "TRAMA_DEV_ORIGIN=http://localhost:5173 node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server/main.ts",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
